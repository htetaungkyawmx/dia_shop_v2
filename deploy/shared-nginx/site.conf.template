# nginx site for __DOMAIN__. Installed as its own file so other sites on this
# server are never edited. certbot adds the TLS blocks to this file.

# ---------------------------------------------------------------- customer shop
server {
    listen 80;
    listen [::]:80;
    server_name __DOMAIN__ www.__DOMAIN__;

    root __WEB_ROOT__/shop;
    index index.html;

    gzip on;
    gzip_types text/css application/javascript application/json application/wasm image/svg+xml;

    # Content-hashed Flutter assets can be cached for a year...
    location ~* ^/(assets|canvaskit)/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }
    # ...but the entry points must always be revalidated or users keep an old build.
    location ~* ^/(index\.html|flutter_bootstrap\.js|flutter_service_worker\.js|main\.dart\.js|version\.json)$ {
        add_header Cache-Control "no-cache";
        try_files $uri =404;
    }
    location / {
        try_files $uri $uri/ /index.html;
    }
}

# ------------------------------------------------------------------ admin panel
server {
    listen 80;
    listen [::]:80;
    server_name admin.__DOMAIN__;

    root __WEB_ROOT__/admin;
    index index.html;

    add_header X-Robots-Tag "noindex, nofollow" always;
    gzip on;
    gzip_types text/css application/javascript application/json application/wasm image/svg+xml;

    location ~* ^/(assets|canvaskit)/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }
    location ~* ^/(index\.html|flutter_bootstrap\.js|flutter_service_worker\.js|main\.dart\.js|version\.json)$ {
        add_header Cache-Control "no-cache";
        try_files $uri =404;
    }
    location / {
        try_files $uri $uri/ /index.html;
    }
}

# -------------------------------------------------------------------------- API
server {
    listen 80;
    listen [::]:80;
    server_name api.__DOMAIN__;

    # Payment screenshots are uploaded through here (the API caps them at 8MB).
    client_max_body_size 10m;

    location / {
        proxy_pass http://127.0.0.1:__API_PORT__;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }
}
