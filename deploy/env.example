# Copy to deploy/.env on the VPS and fill in. Never commit the real file.

# Your domain, without https:// and without a subdomain.
# The stack will serve:
#   https://example.com        customer shop
#   https://admin.example.com  admin panel
#   https://api.example.com    API
DOMAIN=example.com

# Let's Encrypt sends certificate-expiry warnings here.
TLS_EMAIL=you@example.com

# Database. Generate with: openssl rand -base64 24
DB_NAME=dia_shop
DB_USER=dia_shop
DB_PASSWORD=

# Signing key for access tokens. Generate with: openssl rand -base64 48
JWT_SECRET=

# The first admin account, created on first boot only.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Optional: comma-separated Google OAuth client IDs to enable Google Sign-In.
GOOGLE_CLIENT_IDS=

# Tune if your VPS has little RAM. SerialGC keeps the footprint small.
JAVA_OPTS=-XX:MaxRAMPercentage=60 -XX:+UseSerialGC
