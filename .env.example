# Copy to .env and fill in before running `docker compose up -d`.

# Generate with: openssl rand -base64 48
JWT_SECRET=change-me-to-at-least-32-random-characters

# Created on first boot only. Change the password before going live.
ADMIN_EMAIL=admin@diashop.com
ADMIN_PASSWORD=Admin@12345

# Comma-separated. In production list your real domains only.
CORS_ORIGINS=http://localhost:3000,http://localhost:5001

# Public base URL for uploaded payment screenshots.
STORAGE_PUBLIC_URL=http://localhost:8080/uploads

# Optional: enables Google Sign-In when set (comma-separated OAuth client IDs).
GOOGLE_CLIENT_IDS=
